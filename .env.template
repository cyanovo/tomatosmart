# ==================================================
# 番茄温室智能管控平台 - 环境配置文件
# ==================================================
# 使用方法：
#   1. 复制此文件为 .env：cp .env.template .env
#   2. 填写必要的配置项（至少需要填写大模型 API Key）
#   3. 启动系统：docker compose up -d --build
# ==================================================

# ========== 必填配置 ==========

# 大模型 API Key（推荐使用硅基流动免费服务）
# 注册地址：https://cloud.siliconflow.cn/i/Eo5yTHGJ
SILICONFLOW_API_KEY=

# ========== 可选配置 ==========

# 搜索服务 API Key（用于网页搜索功能）
# 获取地址：https://app.tavily.com/
TAVILY_API_KEY=

# JWT 安全配置（首次部署留空，系统会自动生成）
GREENHOUSE_ENV=development
JWT_SECRET_KEY=
GREENHOUSE_INSTANCE_ID=

# ========== 其他可选的大模型 API Key ==========
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# DEEPSEEK_API_KEY=
# MINIMAX_API_KEY=
# DASHSCOPE_API_KEY=

# ========== 大模型视觉识别配置（Qwen3-VL-Plus）==========
# DASHSCOPE_API_KEY=  # 上面已填写则无需重复配置
# VLM_MODEL=qwen3-vl-plus  # 视觉模型名称，默认 qwen3-vl-plus

# ========== IoT / MQTT 配置（智能温室物联网）==========
# 启用本地 Mosquitto MQTT Broker（已内置在 docker-compose 中）
MQTT_ENABLED=true
MQTT_BROKER_URL=mosquitto
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=

# ========== Neo4j 图数据库配置 ==========
# NEO4J_URI=bolt://graph:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=0123456789

# # region neo4j
# NEO4J_URI=
# NEO4J_USERNAME=
# NEO4J_PASSWORD=
# # endregion neo4j

# # Servies
# GREENHOUSE_SUPER_ADMIN_NAME=
# GREENHOUSE_SUPER_ADMIN_PASSWORD=

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# GREENHOUSE_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU
# MINERU_API_KEY=

# Sandbox (deerFlow-style provisioner)
# SANDBOX_PROVIDER=provisioner
# SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# # sandbox-provisioner backend: memory | docker | kubernetes
# SANDBOX_PROVISIONER_BACKEND=docker

# sandbox-provisioner 通用配置
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# SANDBOX_CONTAINER_PORT=8080
# SANDBOX_HEALTH_TIMEOUT_SECONDS=300
# MEMORY_SANDBOX_URL_TEMPLATE=http://agent-sandbox:8000
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7897
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7897

# Docker backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=docker)
# 注意：网络名称已在 docker-compose.yml 中固定为 greenhouse-know_app-network
# SANDBOX_DOCKER_NETWORK=greenhouse-know_app-network
# SANDBOX_DOCKER_THREADS_HOST_PATH=
# SANDBOX_DOCKER_SANDBOX_PREFIX=greenhouse-sandbox
# SANDBOX_DOCKER_SANDBOX_HOST=host.docker.internal

# Kubernetes backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=kubernetes)
# SANDBOX_K8S_NAMESPACE=greenhouse-know
# SANDBOX_NODE_HOST=host.docker.internal
# KUBECONFIG_PATH=/root/.kube/config
# THREAD_PVC=greenhouse-thread
# SKILLS_PVC=greenhouse-skills  # 当前代码会读取，但 Pod 挂载实际仍只使用 THREAD_PVC
